# --- Postgres Container Variables ---
# Do not use special characters, as /@# etc. as they will confuse parser later when constructing db url
# Change data in this section as you like

POSTGRES_USER=bot_user
POSTGRES_PASSWORD=super_secret_password_123
POSTGRES_DB=telegram_bot_db

# --- Bot Application Variables ---
BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN_FROM_BOT_FATHER>

DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"
